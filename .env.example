# NVIDIA NIM free tier (https://build.nvidia.com) — get a key, then copy this
# file to .env (never commit .env — D5: the runner scrubs env before tests).
NIM_API_KEY=
# Optional: override the NIM endpoint (defaults to build.nvidia.com)
NIM_BASE_URL=

# Local Ollama (P4 drop-in; draft/route model chosen by the probe in TODOS.md)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DRAFT_MODEL=qwen3:8b